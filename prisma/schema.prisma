// Custom Content Types model
model CustomContentType {
  id          String   @id @default(cuid())
  name        String   // Display name (e.g., "Recipes", "Workout Plans")
  key         String   // Unique key for API usage (e.g., "recipe", "workout")
  description String?
  icon        String?  // Lucide icon name or custom icon URL
  color       String   @default("#3B82F6") // Hex color
  template    String?  // JSON template for new items of this type
  fields      String?  // JSON schema for custom fields
  isSystem    Boolean  @default(false) // true for built-in types
  isActive    Boolean  @default(true)
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  
  // Relations
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId      String
  contentItems ContentItem[] @relation("CustomTypeItems")
  
  @@unique([userId, key])
  @@map("custom_content_types")
}

// Mobile Link Token for authenticating mobile app
model MobileToken {
  id                String   @id @default(cuid())
  token             String   @unique // Unique token for mobile app
  googleAccessToken String   // Google Drive access token
  googleRefreshToken String?  // Google Drive refresh token
  expiresAt         DateTime // Token expiry time
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  used              Boolean  @default(false)
  usedAt            DateTime?
  
  // Relations
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId            String
  
  @@index([userId])
  @@map("mobile_tokens")
}

// OAuth account links. Required by PrismaAdapter for OAuth sign-in (ADR-007 D2).
// No Session / VerificationToken models: the session strategy is 'jwt' and there is no
// email provider, so those adapter methods are never reached.
model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@map("accounts")
}