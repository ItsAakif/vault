{
  "name": "vault-personal-command-center",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "nodemon --exec \"npx tsx server.ts\" --watch server.ts --watch src --ext ts,tsx,js,jsx",
    "dev:next": "next dev",
    "dev:log": "nodemon --exec \"npx tsx server.ts\" --watch server.ts --watch src --ext ts,tsx,js,jsx > dev.log 2>&1",
    "build": "next build",
    "start": "tsx server.ts",
    "start:prod": "cross-env NODE_ENV=production tsx server.ts",
    "lint": "next lint",
    "type-check": "tsc --noEmit",
    "test": "vitest run",
    "test:run": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "db:push": "prisma db push",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:reset": "prisma migrate reset",
    "db:seed": "node scripts/seed-demo.js",
    "setup": "npm install && npx prisma generate && npx prisma db push && npm run db:seed"
  },
