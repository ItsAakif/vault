# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
node_modules/
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
coverage/
# next.js
.next/
/out/

# production
build/
# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
# The template is committed on purpose: it contains placeholders only, never secrets.
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
local-*
.claude
.z-ai-config
dev.log
/test
/prompt

server.log
# Local SQLite runtime state - never versioned (schema lives in prisma/schema.prisma)
*.db
*.db-journal
*.db-wal
*.db-shm


# Database snapshots and sidecars must never be committed (they hold user rows)
*.db.backup-*
*.db.bak
*.db-wal
*.db-shm
*.sqlite
*.sqlite3

# ---- Local agent / harness artefacts: never published ----
.planning/
.kiro/
.vscode/
.claude/
AGENTS.md
CLAUDE.md

# The mobile client is not part of this repository's published scope.
mobile/

# Local-only developer tooling that forges auth sessions - never ship this.
scripts/mint-session.js

# Run logs
*.log
run*.out
run*.err
