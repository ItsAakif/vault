# Vault - environment template
#
# Copy to `.env` and fill in the REQUIRED values:
#   cp .env.example .env
#
# `.env` is gitignored and must never be committed. Do not paste real secrets into
# this file - every value below is a placeholder.
#
# Grouped as: required -> build-time public -> optional integrations -> optional extras.
# Anything not listed here is not read by the application.


# ---------------------------------------------------------------------------
# REQUIRED
# ---------------------------------------------------------------------------

# SQLite database. Holds only users, the Google Drive token link
# (`cloud_integrations`) and preferences - never your notes, which live in Drive.
# Prefer an ABSOLUTE path: a relative `file:` URL is resolved against different
# directories depending on how Prisma is invoked.
#   local:  file:E:/path/to/vault/prisma/db/vault.db
#   docker: file:/app/data/vault.db      (inside the mounted volume)
DATABASE_URL="file:./prisma/db/vault.db"

# The public origin of the app, no trailing slash.
# Used for NextAuth callbacks and for the Drive OAuth redirect, which is built as
# `${NEXTAUTH_URL}/api/drive/callback`. Must match the redirect URIs registered on
# your Google OAuth client exactly (scheme, host, port).
NEXTAUTH_URL="http://localhost:3000"

# Secret used to sign session JWTs and the OAuth state nonce.
# Generate one:  node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Changing it signs every user out.
NEXTAUTH_SECRET="replace-with-a-random-secret-generated-locally"

# Google OAuth 2.0 client of type "Web application".
# The same client is used for sign-in and for Google Drive.
# Register these redirect URIs on it:
#   <NEXTAUTH_URL>/api/auth/callback/google   (required - sign-in)
#   <NEXTAUTH_URL>/api/drive/callback         (required - Drive connect/reconnect)
# Publish the OAuth consent screen (status "In production"). In "Testing" mode
# Google expires refresh tokens after 7 days, which surfaces as `invalid_grant`.
GOOGLE_CLIENT_ID="your-google-oauth-client-id.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="your-google-oauth-client-secret"


# ---------------------------------------------------------------------------
# BUILD-TIME PUBLIC VALUES  (inlined into the browser bundle by `npm run build`)
# ---------------------------------------------------------------------------
# These are NOT read at runtime. Changing them on a running container does
# nothing; you must rebuild. See the README section "NEXT_PUBLIC_* is baked in
# at build time".
#
# In Docker they are BUILD ARGS (see docker-compose.yml), not runtime env vars.

# Must be the literal string "true" when you run the bundled custom server
# (npm run dev / start / start:prod / the Docker image). This is what enables
# the client's Socket.IO connection. Unset, "false", "1" and "TRUE" all leave
# realtime off.
NEXT_PUBLIC_CUSTOM_SERVER="true"

# Origin the browser opens the websocket against, e.g. "https://vault.example.com".
# If left empty the client falls back to http://localhost:3000, which is wrong for
# any deployed instance.
NEXT_PUBLIC_SOCKET_URL="http://localhost:3000"

# Public VAPID key for browser push notifications. Optional: leave empty to
# disable push. This is a public key, but it is still deployment-specific.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=""


# ---------------------------------------------------------------------------
# OPTIONAL - GOOGLE CALENDAR INTEGRATION
# ---------------------------------------------------------------------------
# Needs the Google Calendar API enabled in the same Cloud project, and this
# redirect URI registered on the OAuth client:
#   <NEXTAUTH_URL>/api/calendar/auth/google/callback
# Leave empty if you only want the built-in calendar (Vault/Calendar).
GOOGLE_REDIRECT_URI="http://localhost:3000/api/calendar/auth/google/callback"


# ---------------------------------------------------------------------------
# OPTIONAL - OUTLOOK / MICROSOFT CALENDAR INTEGRATION
# ---------------------------------------------------------------------------
# Needs an Azure app registration with the Microsoft Graph calendar permissions,
# and this redirect URI registered on it:
#   <NEXTAUTH_URL>/api/calendar/auth/outlook/callback
# Leave all three empty to disable.
OUTLOOK_CLIENT_ID=""
OUTLOOK_CLIENT_SECRET=""
OUTLOOK_REDIRECT_URI="http://localhost:3000/api/calendar/auth/outlook/callback"


# ---------------------------------------------------------------------------
# OPTIONAL - SERVER BEHAVIOUR
# ---------------------------------------------------------------------------

# Value sent as `Access-Control-Allow-Origin` on /api/* responses.
# The header expects a single origin; the code passes this string through as-is,
# so prefer one origin over a list.
ALLOWED_ORIGINS="http://localhost:3000,http://127.0.0.1:3000"

# Local directory used by the file-management upload path.
UPLOAD_DIR="./uploads"

# Only echoed by one status endpoint. Sessions are JWTs and nothing caches in
# Redis, so this changes no behaviour. Leave empty.
# REDIS_URL="redis://localhost:6379"

# Port the custom server listens on.
PORT="3000"

# Set to "production" by `npm run start:prod` and the Docker image.
# Leave unset for local development.
# NODE_ENV="production"


# ---------------------------------------------------------------------------
# OPTIONAL - EMAIL (notifications and account emails)
# ---------------------------------------------------------------------------
# Leave empty unless you want outgoing mail. SMTP_SECURE must be the literal
# string "true" to enable TLS.
SMTP_HOST=""
SMTP_PORT="587"
SMTP_SECURE="false"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM_NAME="Vault Command Center"
SMTP_FROM_EMAIL="noreply@example.com"
SMTP_REPLY_TO=""


# ---------------------------------------------------------------------------
# OPTIONAL - MOBILE CLIENT (closed by default)
# ---------------------------------------------------------------------------
# The web app does not need this. The mobile client's password-login endpoint is
# closed unless this is the literal string "true". It is deliberately not a
# NEXT_PUBLIC_* variable.
# MOBILE_PASSWORD_LOGIN_ENABLED="true"
