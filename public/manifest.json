{
  "name": "Vault: Your Personal Command Center",
  "short_name": "Vault",
  "description": "A comprehensive PWA for personal organization and productivity",
  "start_url": "/",
  "display": "standalone",
  "background_color": "#ffffff",
  "theme_color": "#667eea",
  "orientation": "portrait-primary",
  "scope": "/",
  "lang": "en",
  "categories": ["productivity", "business", "utilities"],
